# ─────────────────────────────────────────────────────────────
#  PixMatch — the public repository only versions source code.
#  Nothing the app generates at runtime, and no build, test or
#  editor artifacts, should ever be committed.
# ─────────────────────────────────────────────────────────────

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Packaging / distribution ---
build/
dist/
sdist/
*.egg
*.egg-info/
.eggs/
develop-eggs/
pip-wheel-metadata/
MANIFEST
# The only versioned .spec is packaging/PixMatch.spec; ignore any other
/*.spec
# macOS icon generated by packaging/build_macos.sh
packaging/resources/icon.icns

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Tests, coverage and linters ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- Data PixMatch generates at runtime ---
# (normally lives in OS-specific folders -- %APPDATA%, ~/Library,
#  ~/.config, ~/.cache -- but just in case it runs portably or saves
#  something inside the repo)
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.log
config.json
.pixmatch_cache/
/logs/
/thumbnails/

# --- Exported reports (CSV / JSON / HTML) ---
/exports/
/reports/
pixmatch-*.csv
pixmatch-*.json
pixmatch-*.html
informe*.csv
informe*.json
informe*.html

# --- Screenshots and manual-testing material ---
/screenshots/
/sandbox/
/scratch/
/testdata/

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Operating system ---
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
